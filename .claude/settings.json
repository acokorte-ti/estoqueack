{
  "permissions": {
    "deny": [
      "Bash(git add -A)",
      "Bash(git add -A *)",
      "Bash(git add --all)",
      "Bash(git add --all *)",
      "Bash(git add .)",
      "Bash(git add . *)",
      "Bash(git add -u)",
      "Bash(git add -u *)",
      "Bash(git commit -a *)",
      "Bash(git commit -am *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Read(./.mega_ro)",
      "Read(./.mega_ro*)",
      "Read(./.github_token)",
      "Read(./.github_token*)",
      "Read(./pass_bkp/**)",
      "Read(./.env)",
      "Read(./**/.env)",
      "Read(../segredos/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "py -3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guarda_bash.py\""
          }
        ]
      }
    ]
  }
}
