# ============================================================
# EstoqueACK — variáveis de ambiente (copie para .env e preencha)
# NUNCA faça commit do arquivo .env
# ============================================================

# Ambiente: dev | homolog | prod
APP_ENV=dev
APP_DOMAIN=estoque.acokorte.com.br
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=troque-esta-chave

# PostgreSQL (banco do sistema)
POSTGRES_DB=estoqueack
POSTGRES_USER=estoqueack
POSTGRES_PASSWORD=troque-esta-senha
DATABASE_URL=postgresql+psycopg://estoqueack:troque-esta-senha@db:5432/estoqueack

# Primeiro administrador (criado apenas se não existir nenhum usuário)
ADMIN_LOGIN=eduardo.macedo
ADMIN_NOME="Eduardo Macedo"
# Senha temporária — troca obrigatória no primeiro acesso
ADMIN_SENHA_INICIAL=troque-no-primeiro-acesso

# Regras de negócio
# Excedente aceito sobre o peso previsto (que já inclui sobremetal). Acima disso: justificativa obrigatória.
TOLERANCIA_EXCESSO_PCT=5
TOLERANCIA_FALTA_PCT=20
# Sobremetal (bruto x peça acabada) aceito na solicitação de corte. Acima disso: justificativa obrigatória.
TOLERANCIA_SOBREMETAL_PCT=20
ESPESSURA_SERRA_MM=3
DENSIDADE_PADRAO=7.85

# Segurança de login
LOGIN_MAX_TENTATIVAS=5
LOGIN_BLOQUEIO_MINUTOS=15
SESSAO_HORAS=10
# "Manter conectado" na tela de login
SESSAO_LEMBRAR_DIAS=30
# Recuperação de senha por e-mail
RECUPERACAO_MINUTOS=30
RECUPERACAO_MAX_POR_HORA=3
SENHA_TAMANHO_MINIMO=10

# E-mail (recuperação de senha). Base dos links enviados:
APP_URL=https://estoque.acokorte.com.br
# Opção 1 (preferida): Microsoft Graph. App no Entra ID com permissão de APLICATIVO Mail.Send,
# restrita à caixa do remetente. Passo a passo em docs/tecnico/02_email_graph.md
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=troque
GRAPH_REMETENTE=estoque@acokorte.com.br
# Opção 2: SMTP (só é usado se o Graph acima estiver vazio)
SMTP_HOST=
SMTP_PORTA=587
SMTP_USUARIO=
SMTP_SENHA=troque
SMTP_REMETENTE="EstoqueACK <estoque@acokorte.com.br>"
SMTP_STARTTLS=true

# ERP Mega (Oracle 19c) — usuário SOMENTE LEITURA
MEGA_HABILITADO=false
MEGA_DSN=10.0.0.235:1521/dbmegaxt_pdb1.sub08032113590.vcnmegaxt.oraclevcn.com
MEGA_USUARIO=estoqueack_ro
MEGA_SENHA=troque
# O Mega exige criptografia nativa: caminho do Instant Client 19 dentro do container
MEGA_INSTANT_CLIENT=/opt/instantclient
# Escrita no Mega: reservado para o futuro. Mantenha false.
MEGA_ESCRITA_HABILITADA=false

# Porta local do site (o nginx do servidor encaminha para ela)
WEB_PORTA=8090
